---
import MasterPortfolio from "@components/Features/MasterPortfolio/MasterPortfolio.astro";
import RootLayout from "@layouts/RootLayout.astro";
import { languages, type Locale } from "@i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const title = lang === "vi"
  ? "Portfolio đầy đủ | Vũ Tuấn Cường"
  : "Full portfolio | Vu Tuan Cuong";
---

<RootLayout title={title} enableFooter mode="master">
  <MasterPortfolio lang={lang} />
</RootLayout>
