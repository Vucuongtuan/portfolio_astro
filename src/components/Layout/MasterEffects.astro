<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let lenis: Lenis | null = null;
  let ticker: ((time: number) => void) | null = null;

  const destroyLenis = () => {
    lenis?.destroy();
    lenis = null;

    if (ticker) {
      gsap.ticker.remove(ticker);
      ticker = null;
    }
  };

  const initLenis = () => {
    destroyLenis();
    lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    lenis.on("scroll", ScrollTrigger.update);
    ticker = (time) => lenis?.raf(time * 1000);
    gsap.ticker.add(ticker);
    gsap.ticker.lagSmoothing(0);
  };

  const handleSmoothNavigate = (event: Event) => {
    const href = (event as CustomEvent<{ href?: string }>).detail?.href;
    if (!href) return;
    const target = document.querySelector<HTMLElement>(href);
    if (!target) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (lenis && !reduceMotion) {
      const targetY = target.getBoundingClientRect().top + window.scrollY - 16;
      const distance = Math.abs(targetY - window.scrollY);
      const duration = Math.min(2.4, Math.max(0.9, distance / 1900));
      lenis.scrollTo(target, {
        offset: -16,
        duration,
        easing: (t) => t < 0.5
          ? 4 * t * t * t
          : 1 - Math.pow(-2 * t + 2, 3) / 2,
        onComplete: () => history.replaceState(null, "", href),
      });
      return;
    }

    target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
    history.replaceState(null, "", href);
  };

  window.removeEventListener("master:navigate", handleSmoothNavigate);
  window.addEventListener("master:navigate", handleSmoothNavigate);

  initLenis();

  document.addEventListener("astro:after-swap", () => {
    window.scrollTo(0, 0);
    initLenis();
    ScrollTrigger.refresh();
  });

  document.addEventListener("astro:page-load", () => ScrollTrigger.refresh());
  document.addEventListener("astro:before-swap", destroyLenis);
</script>
