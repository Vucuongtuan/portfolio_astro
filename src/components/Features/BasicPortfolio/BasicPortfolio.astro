---
import BasicFeatures from "./BasicFeatures";
import { getEntry } from "astro:content";
import type { Locale } from "@i18n/ui";
import { getRoute } from "@i18n/utils";
import { getBasicPortfolioData } from "./basic-data";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const [aboutEntry, portfolio] = await Promise.all([
  getEntry("about", lang),
  getBasicPortfolioData(lang),
]);

if (!aboutEntry) {
  throw new Error(`About content is missing for ${lang}.`);
}

const projects = portfolio.projects.map((project) => ({
  ...project,
  thumbnail: project.thumbnail?.src,
  href: getRoute(lang, `basic/works/${project.id}`),
}));

---

<BasicFeatures
  lang={lang}
  about={{ ...aboutEntry.data, body: aboutEntry.body }}
  experience={portfolio.experience ?? { title: "Experience", items: [] }}
  projects={projects}
  tools={portfolio.skills}
  client:load
/>
